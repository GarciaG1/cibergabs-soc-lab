# Copia este archivo como .env  (cp .env.example .env)

# Opcional. Con key, el triage lo hace un AGENTE DE IA (Gemini).
# Sin key, el lab funciona igual en "modo reglas" (analista determinista).
# Consíguela gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Puerto del dashboard en tu máquina. Si "ports are not available" en Windows,
# revisa: netsh int ipv4 show excludedportrange protocol=tcp   y usa uno libre.
SOC_PORT=8080

# Modelo a usar (alias recomendado: siempre el flash más reciente)
GEMINI_MODEL=gemini-flash-lite-latest

# Solo para el atacante automático (docker compose --profile auto up -d).
# Normalmente lanzas el ataque con el botón del dashboard.
VARIANT=base       # base | injection
REPLAY=0           # 0 = una vez; >0 = repite cada N segundos
DURATION=24        # segundos reales que dura la noche simulada
